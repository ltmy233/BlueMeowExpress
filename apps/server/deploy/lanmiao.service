[Unit]
Description=LanMiao Express API and admin panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lanmiao
Group=lanmiao
WorkingDirectory=/opt/lanmiao/app
EnvironmentFile=/opt/lanmiao/config/server.env
ExecStart=/opt/lanmiao/runtime/node/bin/node /opt/lanmiao/app/dist/index.js
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lanmiao/data
MemoryMax=512M
CPUQuota=100%
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
