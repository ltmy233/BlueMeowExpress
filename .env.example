# 服务端环境变量（根目录副本，仅供参考）

# 运行模式
NODE_ENV=production

# 监听地址，只绑定本机，由 nginx 等反向代理对外
HOST=127.0.0.1
PORT=3210

# SQLite 数据库路径
DATABASE_PATH=./data/lanmiao.db

# JWT 签名密钥，>=32 字符随机串，用 openssl rand -base64 48 生成
JWT_SECRET=replace-with-at-least-32-random-bytes

# Root 管理密钥的 SHA-256 十六进制，用 printf '%s' '你的密钥' | sha256sum 生成，只存哈希
ADMIN_ROOT_KEY_HASH=sha256-hex-of-root-key

# SMTP 邮箱配置（163 授权码，不是登录密码）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@163.com
SMTP_PASS=your-163-authorization-code
SMTP_FROM_EMAIL=your-email@163.com
SMTP_FROM_NAME=你的发件人名称

# 公网 HTTPS 域名，用于 CORS 和链接生成
PUBLIC_ORIGIN=https://your-server.example

# 离线密文队列保留秒数，默认 86400（1 天）
OFFLINE_TTL_SECONDS=86400

# 邮箱验证码有效期秒数，默认 600（10 分钟）
EMAIL_CODE_TTL_SECONDS=600
